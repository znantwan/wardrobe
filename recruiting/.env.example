# ─── Healthcare AI Recruiting Tool — API Keys ────────────────────────────────
# Copy this file to .env and fill in the keys you have.
# All keys are optional; the tool degrades gracefully when keys are absent.
# TechCrunch / MobiHealthNews RSS is always used (no key needed).


# ── Company Discovery ────────────────────────────────────────────────────────

# Crunchbase Basic API  (crunchbase.com/account/api)
# Provides: structured company search, funding rounds, categories
# Free tier available.
CRUNCHBASE_API_KEY=

# NewsAPI  (newsapi.org)  — free tier: 100 requests/day
# Provides: full-text search of recent funding news articles
NEWSAPI_KEY=


# ── Alumni Search (LinkedIn via Google) ──────────────────────────────────────
# You need ONE of the two options below.

# Option A — Google Custom Search JSON API  (free tier: 100 queries/day)
#   Step 1: console.cloud.google.com → enable "Custom Search JSON API" → create API key
#   Step 2: programmablesearchengine.google.com → create engine → copy CX ID
GOOGLE_API_KEY=
GOOGLE_CX_ID=

# Option B — SerpAPI  (serpapi.com)  — paid but cheap (~$50/mo for 5k searches)
# More reliable than Google CSE for LinkedIn searches.
SERPAPI_KEY=


# ── Email Enrichment ─────────────────────────────────────────────────────────

# Hunter.io  (hunter.io)  — free tier: 25 email searches/month
# Provides: email discovery per contact using company domain
HUNTER_API_KEY=
